---
import '@fontsource-variable/archivo';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import SiteHeader from '../components/SiteHeader.astro';
import type { Locale, SiteContent } from '../types/site';
import '../styles/global.css';

interface Props {
  locale: Locale;
  content: SiteContent;
}

const { locale, content } = Astro.props;
const isChinese = locale === 'zh';
const home = isChinese ? '/' : '/en/';
const docs = isChinese ? '/docs/' : '/en/docs/';
const alternateHome = isChinese ? '/en/' : '/';
const canonicalBase = import.meta.env.PUBLIC_SITE_URL;
const canonical = canonicalBase ? new URL(home, canonicalBase).toString() : undefined;
const alternate = canonicalBase ? new URL(alternateHome, canonicalBase).toString() : alternateHome;
---

<!doctype html>
<html lang={content.meta.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#090b0f" />
    <meta name="generator" content={Astro.generator} />
    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MiniClaw" />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:locale" content={isChinese ? 'zh_CN' : 'en_US'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang={isChinese ? 'en' : 'zh-CN'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={isChinese ? home : alternateHome} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isChinese ? '跳到主要内容' : 'Skip to content'}</a>
    <SiteHeader {locale} nav={content.nav} />
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p>{content.footer.statement}</p>
        <nav aria-label={isChinese ? '页脚导航' : 'Footer navigation'}>
          <a href="https://github.com/NEDONION/miniclaw">{content.footer.source}</a>
          <a href="https://github.com/NEDONION/miniclaw/issues">{content.footer.issues}</a>
          <a href={docs}>{content.footer.docs}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
