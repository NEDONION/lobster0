---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClawTrace from './ClawTrace.astro';
import CommandBlock from './CommandBlock.astro';
import EvidenceRail from './EvidenceRail.astro';
import MemorySection from './MemorySection.astro';
import QuickStart from './QuickStart.astro';
import RuntimeFlow from './RuntimeFlow.astro';
import SafetySection from './SafetySection.astro';
import SurfaceSection from './SurfaceSection.astro';
import WorkflowGallery from './WorkflowGallery.astro';
import contentByLocale from '../content-data/site-content.json';
import facts from '../content-data/project-facts.json';
import type { Locale } from '../types/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = contentByLocale[locale];
const isChinese = locale === 'zh';
const docs = isChinese ? '/docs/getting-started/' : '/en/docs/getting-started/';
---

<BaseLayout {locale} {content}>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__rail" aria-hidden="true">
      <span>MINICLAW / 2026</span>
      <span>OPEN SOURCE</span>
    </div>
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow"><span aria-hidden="true"></span>{content.hero.eyebrow}</p>
        <h1 id="hero-heading">{content.hero.title}</h1>
        <p class="hero__lead">{content.hero.lead}</p>
        <div class="hero__actions">
          <a class="button button--primary" href={docs}>
            {content.hero.primaryCta}<span aria-hidden="true">↘</span>
          </a>
          <a class="button button--quiet" href={facts.links.github}>
            {content.hero.secondaryCta}<span aria-hidden="true">↗</span>
          </a>
        </div>
        <CommandBlock
          command={facts.install}
          label={content.hero.installLabel}
          copyLabel={isChinese ? '复制命令' : 'Copy commands'}
          copiedLabel={isChinese ? '已复制' : 'Copied'}
        />
      </div>
      <ClawTrace trace={content.trace} />
    </div>
    <div class="shell hero__footnote">
      <span>PYTHON {facts.requirements.python}</span>
      <span>NODE {facts.requirements.node}</span>
      <span>OPENAI-COMPATIBLE</span>
    </div>
  </section>
  <EvidenceRail evidence={content.evidence} {facts} />
  <RuntimeFlow flow={content.flow} />
  <SurfaceSection surfaces={content.surfaces} />
  <SafetySection safety={content.safety} {facts} />
  <MemorySection memory={content.memory} />
  <WorkflowGallery workflows={content.workflows} />
  <QuickStart {locale} quickStart={content.quickStart} {facts} />
</BaseLayout>
