---
import type { ProjectFacts, SiteContent } from '../types/site';

interface Props {
  safety: SiteContent['safety'];
  facts: ProjectFacts;
}

const { safety, facts } = Astro.props;
---

<section class="safety-section light-section section-pad" id="safety" aria-labelledby="safety-heading">
  <div class="shell section-heading section-heading--light">
    <p class="eyebrow eyebrow--light"><span aria-hidden="true"></span>{safety.eyebrow}</p>
    <h2 id="safety-heading">{safety.title}</h2>
    <p>{safety.lead}</p>
  </div>
  <div class="shell safety-section__grid">
    <div class="policy-readout" aria-label="Permission modes">
      <div class="policy-readout__bar">
        <span>POLICY / PERMISSION_MODE</span>
        <span>BOUND</span>
      </div>
      <div class="policy-readout__modes">
        {facts.permissionModes.map((mode, index) => (
          <span class:list={{ 'is-active': index === 0 }}>{mode}</span>
        ))}
      </div>
      <div class="policy-readout__lines">
        <p><span>workspace</span><strong>OWNER_DEFINED</strong></p>
        <p><span>shell_input</span><strong>ARGV_ARRAY</strong></p>
        <p><span>approval</span><strong>PARAMETER_BOUND</strong></p>
        <p><span>secret_exposure</span><strong class="is-denied">DENIED</strong></p>
      </div>
    </div>
    <div class="safety-list">
      {safety.items.map((item) => (
        <article>
          <span aria-hidden="true"></span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
