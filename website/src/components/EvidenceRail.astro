---
import type { ProjectFacts, SiteContent } from '../types/site';

interface Props {
  evidence: SiteContent['evidence'];
  facts: ProjectFacts;
}

const { evidence, facts } = Astro.props;
const metrics = [
  { value: '1', label: evidence.labels.runtime },
  { value: String(facts.counts.surfaces), label: evidence.labels.surfaces },
  { value: String(facts.counts.tools), label: evidence.labels.tools },
  { value: String(facts.counts.channelCases), label: evidence.labels.channels },
  { value: String(facts.counts.automationCases), label: evidence.labels.automations },
];
---

<section class="evidence-rail" aria-labelledby="evidence-heading">
  <div class="shell evidence-rail__head">
    <p class="eyebrow eyebrow--light"><span aria-hidden="true"></span>{evidence.eyebrow}</p>
    <h2 id="evidence-heading">{evidence.title}</h2>
    <p class="evidence-rail__disclosure">{evidence.disclosure}</p>
  </div>
  <dl class="shell evidence-rail__metrics">
    {metrics.map((metric) => (
      <div>
        <dt>{metric.label}</dt>
        <dd>{metric.value}</dd>
      </div>
    ))}
  </dl>
</section>
