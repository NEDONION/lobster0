---
import LogoMark from './LogoMark.astro';
import type { Locale, SiteContent } from '../types/site';

interface Props {
  locale: Locale;
  nav: SiteContent['nav'];
}

const { locale, nav } = Astro.props;
const isChinese = locale === 'zh';
const docs = isChinese ? '/docs/' : '/en/docs/';
const alternate = isChinese ? '/en/' : '/';
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__brand" href={isChinese ? '/' : '/en/'} aria-label="MiniClaw home">
      <LogoMark />
    </a>
    <nav class="site-header__nav" aria-label={isChinese ? '主导航' : 'Primary navigation'}>
      <a href="#product">{nav.product}</a>
      <a href="#safety">{nav.safety}</a>
      <a href="#channels">{nav.channels}</a>
      <a href={docs}>{nav.docs}</a>
    </nav>
    <div class="site-header__actions">
      <a class="language-link" href={alternate} lang={isChinese ? 'en' : 'zh-CN'}>
        {nav.language}
      </a>
      <a class="github-link" href="https://github.com/NEDONION/miniclaw">
        {nav.github}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>
