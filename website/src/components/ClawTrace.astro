---
import type { SiteContent } from '../types/site';

interface Props {
  trace: SiteContent['trace'];
}

const { trace } = Astro.props;
---

<aside class="claw-trace" aria-labelledby="trace-heading">
  <div class="claw-trace__heading">
    <p class="eyebrow eyebrow--trace"><span aria-hidden="true"></span>{trace.eyebrow}</p>
    <h2 id="trace-heading">{trace.title}</h2>
    <p>{trace.description}</p>
  </div>
  <ol class="claw-trace__list">
    {trace.steps.map((step, index) => (
      <li class:list={['claw-trace__step', `is-${step.state}`]} style={`--trace-delay: ${index * 0.42}s`}>
        <span class="claw-trace__index">{String(index + 1).padStart(2, '0')}</span>
        <span class="claw-trace__event">{step.event}</span>
        <span class="claw-trace__detail">{step.detail}</span>
        <span class="claw-trace__state">{step.state}</span>
      </li>
    ))}
  </ol>
</aside>
