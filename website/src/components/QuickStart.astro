---
import CommandBlock from './CommandBlock.astro';
import type { Locale, ProjectFacts, SiteContent } from '../types/site';

interface Props {
  locale: Locale;
  quickStart: SiteContent['quickStart'];
  facts: ProjectFacts;
}

const { locale, quickStart, facts } = Astro.props;
const isChinese = locale === 'zh';
const docs = isChinese ? '/docs/getting-started/' : '/en/docs/getting-started/';
---

<section class="quick-start section-pad" aria-labelledby="quick-start-heading">
  <div class="shell quick-start__grid">
    <div class="quick-start__copy">
      <p class="eyebrow"><span aria-hidden="true"></span>{quickStart.eyebrow}</p>
      <h2 id="quick-start-heading">{quickStart.title}</h2>
      <p>{quickStart.lead}</p>
      <div class="quick-start__links">
        <a class="button button--primary" href={docs}>{quickStart.docsCta}<span aria-hidden="true">↘</span></a>
        <a class="button button--quiet" href={facts.links.github}>{quickStart.contributeCta}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <CommandBlock
      command={facts.install}
      label={isChinese ? '完整安装步骤' : 'Full install sequence'}
      copyLabel={isChinese ? '复制命令' : 'Copy commands'}
      copiedLabel={isChinese ? '已复制' : 'Copied'}
    />
  </div>
</section>
