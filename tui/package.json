{
  "name": "@lobster0/pi-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25"
  },
  "exports": {
    "./bridge-client": "./dist/bridge-client.js",
    "./protocol": "./dist/protocol.js",
    "./state": "./dist/state.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "release:deploy": "corepack pnpm --filter @lobster0/pi-tui deploy --legacy --prod",
    "test": "tsc -p tsconfig.json && node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
