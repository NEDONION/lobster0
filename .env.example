# DeepSeek V4 Pro through its OpenAI-compatible endpoint
LOBSTER0_MODEL_BASE_URL=https://api.deepseek.com
LOBSTER0_MODEL_API_KEY=replace-me
LOBSTER0_MODEL_NAME=deepseek-v4-pro

# Optional Phase 4 Feishu enterprise application; install with: uv sync --extra feishu
# Keep the real .env mode at 0600. Lobster0 never stores these values in config.toml.
LOBSTER0_FEISHU_APP_ID=replace-me
LOBSTER0_FEISHU_APP_SECRET=

# Optional Phase 5 Telegram and Discord bots. Install with: uv sync --extra channels
# Values stay empty until the corresponding Channel is explicitly enabled.
LOBSTER0_TELEGRAM_BOT_TOKEN=
LOBSTER0_DISCORD_BOT_TOKEN=
