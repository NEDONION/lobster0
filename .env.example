# DeepSeek V4 Pro through its OpenAI-compatible endpoint
MINICLAW_MODEL_BASE_URL=https://api.deepseek.com
MINICLAW_MODEL_API_KEY=replace-me
MINICLAW_MODEL_NAME=deepseek-v4-pro

# Optional Phase 4 Feishu enterprise application; install with: uv sync --extra feishu
# Keep the real .env mode at 0600. MiniClaw never stores these values in config.toml.
MINICLAW_FEISHU_APP_ID=replace-me
MINICLAW_FEISHU_APP_SECRET=

# Optional Phase 5 Telegram and Discord bots. Install with: uv sync --extra channels
# Values stay empty until the corresponding Channel is explicitly enabled.
MINICLAW_TELEGRAM_BOT_TOKEN=
MINICLAW_DISCORD_BOT_TOKEN=
