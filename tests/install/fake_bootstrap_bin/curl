#!/usr/bin/env python3
"""供 bootstrap 集成测试使用的离线 curl fake。

只理解模板固定使用的调用形状：
``curl -fL --proto '=https' --tlsv1.2 --retry 3 --retry-connrefused
[--max-filesize N] -sS -o DEST URL``. 按 URL basename 从 ``FAKE_HTTP_ROOT``
提供 fixture bytes，并可通过环境变量模拟网络失败、被中断的传输或超过
``--max-filesize`` 的响应，不访问任何真实网络。
"""

from __future__ import annotations

import json
import os
import sys
import time


def _log(args: list[str]) -> None:
    """把本次调用追加进 ``FAKE_CALL_LOG``（若已设置）。"""
    log = os.environ.get("FAKE_CALL_LOG")
    if not log:
        return
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"cmd": "curl", "args": args}) + "\n")


def main() -> int:
    """离线模拟 curl 下载、网络失败与中断传输。"""
    args = sys.argv[1:]
    _log(args)
    if "-o" not in args or not args:
        return 2
    dest = args[args.index("-o") + 1]
    url = args[-1]
    name = url.rsplit("/", 1)[-1]
    max_filesize = None
    if "--max-filesize" in args:
        max_filesize = int(args[args.index("--max-filesize") + 1])

    sleep_seconds = os.environ.get("FAKE_CURL_SLEEP")
    if sleep_seconds:
        time.sleep(float(sleep_seconds))

    fail_tokens = [item for item in os.environ.get("FAKE_CURL_FAIL_MATCH", "").split(",") if item]
    if any(token in url for token in fail_tokens):
        return 7

    root = os.environ.get("FAKE_HTTP_ROOT")
    if not root:
        return 2
    source = os.path.join(root, name)
    if not os.path.isfile(source):
        return 22
    with open(source, "rb") as handle:
        payload = handle.read()

    if max_filesize is not None and len(payload) > max_filesize:
        # Mimic real curl aborting a --max-filesize transfer mid-stream: at
        # most the bound is ever written to disk, never the full response.
        with open(dest, "wb") as handle:
            handle.write(payload[:max_filesize])
        return 63

    truncate_tokens = [
        item for item in os.environ.get("FAKE_CURL_TRUNCATE_MATCH", "").split(",") if item
    ]
    if any(token in url for token in truncate_tokens):
        payload = payload[: len(payload) // 2]
        with open(dest, "wb") as handle:
            handle.write(payload)
        return 18

    with open(dest, "wb") as handle:
        handle.write(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
