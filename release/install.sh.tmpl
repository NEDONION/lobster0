#!/bin/sh
# MiniClaw one-line install bootstrap.
#
# This script is intentionally minimal. It never parses the release
# manifest, never edits configuration or shell profiles, never invokes
# sudo, never writes service files and never touches an existing
# installation's `current` link. Its only job is to establish a
# verified trust root -- a pinned uv, a managed Python 3.12 and the
# hash-verified release manifest and installer -- and then hand off
# every real decision to the stdlib-only installer zipapp via `exec`.
#
# Generated by scripts/render_install_script.py. Do not edit by hand.
set -eu
umask 077

UV_VERSION='{{UV_VERSION}}'
RELEASE_TAG='{{RELEASE_TAG}}'
REPO_BASE_URL='{{REPO_BASE_URL}}'

MANIFEST_FILENAME='{{MANIFEST_FILENAME}}'
MANIFEST_URL='{{MANIFEST_URL}}'
MANIFEST_SHA256='{{MANIFEST_SHA256}}'
MANIFEST_SIZE='{{MANIFEST_SIZE}}'

INSTALLER_FILENAME='{{INSTALLER_FILENAME}}'
INSTALLER_URL='{{INSTALLER_URL}}'
INSTALLER_SHA256='{{INSTALLER_SHA256}}'
INSTALLER_SIZE='{{INSTALLER_SIZE}}'

UV_LINUX_X86_64_URL='{{UV_LINUX_X86_64_URL}}'
UV_LINUX_X86_64_SHA256='{{UV_LINUX_X86_64_SHA256}}'
UV_LINUX_ARM64_URL='{{UV_LINUX_ARM64_URL}}'
UV_LINUX_ARM64_SHA256='{{UV_LINUX_ARM64_SHA256}}'
UV_MACOS_X86_64_URL='{{UV_MACOS_X86_64_URL}}'
UV_MACOS_X86_64_SHA256='{{UV_MACOS_X86_64_SHA256}}'
UV_MACOS_ARM64_URL='{{UV_MACOS_ARM64_URL}}'
UV_MACOS_ARM64_SHA256='{{UV_MACOS_ARM64_SHA256}}'

fail() {
  printf 'miniclaw-install: error: %s\n' "$1" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

# 2. Detect OS, architecture and the base commands bootstrap depends on.
need_cmd uname
need_cmd mktemp
need_cmd curl
need_cmd tar
need_cmd mkdir
need_cmd chmod
need_cmd rm
need_cmd wc
if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
  fail "missing required command: sha256sum or shasum"
fi

sha256_file() {
  target="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    output=$(sha256sum "$target") || fail "could not hash $target"
  else
    output=$(shasum -a 256 "$target") || fail "could not hash $target"
  fi
  printf '%s' "${output%% *}"
}

file_size() {
  raw=$(wc -c < "$1") || fail "could not size $1"
  printf '%s' "$(set -- $raw; printf '%s' "$1")"
}

os_name=$(uname -s)
arch_name=$(uname -m)
case "$os_name" in
  Linux) os_key=linux ;;
  Darwin) os_key=macos ;;
  *) fail "unsupported operating system: $os_name" ;;
esac
case "$arch_name" in
  x86_64|amd64) arch_key=x86_64 ;;
  arm64|aarch64) arch_key=arm64 ;;
  *) fail "unsupported architecture: $arch_name" ;;
esac
platform_key="${os_key}-${arch_key}"
case "$platform_key" in
  linux-x86_64) uv_url=$UV_LINUX_X86_64_URL; uv_sha256=$UV_LINUX_X86_64_SHA256 ;;
  linux-arm64) uv_url=$UV_LINUX_ARM64_URL; uv_sha256=$UV_LINUX_ARM64_SHA256 ;;
  macos-x86_64) uv_url=$UV_MACOS_X86_64_URL; uv_sha256=$UV_MACOS_X86_64_SHA256 ;;
  macos-arm64) uv_url=$UV_MACOS_ARM64_URL; uv_sha256=$UV_MACOS_ARM64_SHA256 ;;
  *) fail "unsupported platform: $platform_key" ;;
esac

# 3. Create an owner-only private working tree for this run only.
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/miniclaw-install.XXXXXX") || fail "could not create a private temporary directory"
chmod 700 "$work_dir"

cleanup() {
  rm -rf "$work_dir"
}
trap cleanup EXIT

# Each signal exits with its conventional 128+n code (130/143/129) so a
# wrapper or CI consumer can tell which signal actually interrupted the run.
terminate() {
  trap - EXIT INT TERM HUP
  cleanup
  exit "$1"
}
trap 'terminate 130' INT
trap 'terminate 143' TERM
trap 'terminate 129' HUP

fetch() {
  # $1 = https URL, $2 = destination path inside work_dir, $3 = optional
  # exact pinned byte size. When given, curl is bounded with --max-filesize
  # so a hostile or compromised endpoint cannot stream unbounded bytes onto
  # disk before the size/hash checks below ever run. The uv archive has no
  # pinned size in runtime-versions.json, so its fetch is left unbounded by
  # size here; its SHA-256 is still verified in full afterwards.
  if [ -n "${3:-}" ]; then
    curl -fL --proto '=https' --tlsv1.2 --retry 3 --retry-connrefused \
      --max-filesize "$3" -sS -o "$2" "$1" \
      || fail "download failed: $1"
  else
    curl -fL --proto '=https' --tlsv1.2 --retry 3 --retry-connrefused -sS -o "$2" "$1" \
      || fail "download failed: $1"
  fi
}

# 4/5. Download the pinned uv release archive and verify its embedded hash
# before extracting the single trusted `uv` executable.
uv_archive="$work_dir/uv.tar.gz"
fetch "$uv_url" "$uv_archive"
actual_uv_sha256=$(sha256_file "$uv_archive")
[ "$actual_uv_sha256" = "$uv_sha256" ] || fail "uv archive checksum mismatch"

uv_extract_dir="$work_dir/uv-extract"
mkdir "$uv_extract_dir"
tar -xzf "$uv_archive" -C "$uv_extract_dir"
uv_bin=""
for candidate in "$uv_extract_dir"/*/uv "$uv_extract_dir"/uv; do
  if [ -f "$candidate" ] && [ ! -L "$candidate" ]; then
    if [ -n "$uv_bin" ]; then
      fail "unexpected uv archive layout"
    fi
    uv_bin=$candidate
  fi
done
[ -n "$uv_bin" ] || fail "uv executable missing from archive"
chmod 0755 "$uv_bin"

# 6. Download the exact release manifest and installer pyz, verifying the
# embedded size and hash of each before either is used for anything.
manifest_file="$work_dir/$MANIFEST_FILENAME"
fetch "$MANIFEST_URL" "$manifest_file" "$MANIFEST_SIZE"
actual_manifest_sha256=$(sha256_file "$manifest_file")
[ "$actual_manifest_sha256" = "$MANIFEST_SHA256" ] || fail "manifest checksum mismatch"
actual_manifest_size=$(file_size "$manifest_file")
[ "$actual_manifest_size" = "$MANIFEST_SIZE" ] || fail "manifest size mismatch"

installer_file="$work_dir/$INSTALLER_FILENAME"
fetch "$INSTALLER_URL" "$installer_file" "$INSTALLER_SIZE"
actual_installer_sha256=$(sha256_file "$installer_file")
[ "$actual_installer_sha256" = "$INSTALLER_SHA256" ] || fail "installer checksum mismatch"
actual_installer_size=$(file_size "$installer_file")
[ "$actual_installer_size" = "$INSTALLER_SIZE" ] || fail "installer size mismatch"

# 7. Use the verified managed uv -- never a PATH uv -- to install a managed
# Python 3.12 inside the same private, owner-only bootstrap tree.
python_root="$work_dir/python"
mkdir "$python_root"
UV_PYTHON_INSTALL_DIR=$python_root
export UV_PYTHON_INSTALL_DIR
"$uv_bin" python install 3.12 || fail "managed Python install failed"
managed_python=$("$uv_bin" python find --managed-python 3.12) || fail "managed Python not found"
case "$managed_python" in
  */bin/python3.12) : ;;
  *) fail "unexpected managed Python layout" ;;
esac
managed_python_root=${managed_python%/bin/python3.12}

# 8/9. Hand off to the stdlib-only installer, forwarding the internal
# bootstrap flags plus every original public flag unchanged, and let the
# installer's exit code become this script's exit code.
exec "$managed_python" "$installer_file" \
  --manifest-file "$manifest_file" \
  --manifest-sha256 "$MANIFEST_SHA256" \
  --managed-uv "$uv_bin" \
  --managed-python-root "$managed_python_root" \
  --managed-python-executable "$managed_python" \
  "$@"
